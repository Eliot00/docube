{
	"name": "docube-root",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"workspaces": {
		"packages": [
			"packages/*"
		],
		"catalog": {
			"@types/bun": "1.3.14",
			"typescript": "^7.0.2",
			"effect": "^3.22.0"
		}
	},
	"scripts": {
		"build": "turbo build",
		"dev": "turbo dev",
		"lint": "oxlint --type-aware",
		"format": "oxfmt",
		"prepare": "husky"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.2.0",
		"oxfmt": "^0.61.0",
		"oxlint": "^1.76.0",
		"oxlint-tsgolint": "^7.0.2001",
		"turbo": "^2.10.7"
	},
	"lint-staged": {
		"*.{json,md}": "oxfmt --no-error-on-unmatched-pattern",
		"*.{js,jsx,ts,tsx}": [
			"oxfmt --no-error-on-unmatched-pattern",
			"oxlint --fix --type-aware"
		]
	},
	"packageManager": "bun@1.2.23"
}
