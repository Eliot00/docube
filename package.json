{
  "name": "docube-root",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "oxlint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "oxlint": "^1.32.0",
    "prettier": "3.6.2",
    "turbo": "^2.6.3"
  },
  "packageManager": "bun@1.2.23",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "1.2.23",
      "typescript": "^5.9.2",
      "effect": "^3.21.2"
    }
  },
  "lint-staged": {
    "*.json": "bunx prettier --write",
    "*.{js,jsx,ts,tsx}": [
      "bunx prettier --write",
      "bunx oxlint"
    ]
  }
}
